# Append only these settings to the existing project configuration after review.
# Never overwrite an existing .env file. This example itself is not loaded.
READING_TEST_ENABLED=false
READING_TEST_UIDS=
READING_MOLLIE_PROFILE_ID=
READING_RETURN_URL=https://tools.jufzisa.be/lezen/mijn-account.html?test=1
READING_WEBHOOK_URL=https://europe-west1-zisa-spelletjesmaker-pro.cloudfunctions.net/readingMollieWebhook
READING_TEST_MAIL_ENABLED=false
READING_TEST_RECIPIENT=
# MOLLIE_READING_TEST_KEY belongs in Secret Manager, not in this file.
# Leave MOLLIE_API_KEY and MOLLIE_LIVE_KEY used by existing Pro functions unchanged.

# Real-payment processing and public sales have separate gates.
# Keep SALES_OPEN=false during the controlled purchase; only listed buyers can pay.
READING_LIVE_ENABLED=false
READING_LIVE_SALES_OPEN=false
READING_LIVE_UIDS=
READING_LIVE_EMAILS=
READING_LIVE_MOLLIE_PROFILE_ID=
READING_LIVE_RETURN_URL=https://tools.jufzisa.be/lezen/mijn-account.html
READING_LIVE_WEBHOOK_URL=https://europe-west1-zisa-spelletjesmaker-pro.cloudfunctions.net/readingLiveMollieWebhook
READING_LIVE_MAIL_ENABLED=false
# MOLLIE_READING_LIVE_KEY: separate Secret Manager binding, exact profile checked before checkout.
# Turning off SALES_OPEN does not stop existing paid access, cancellations or renewal webhooks.
